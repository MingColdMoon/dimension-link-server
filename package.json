{
  "name": "dimension-link-server",
  "version": "0.1.0",
  "private": true,
  "description": "次元链接微服务：Koa + PostgreSQL + Redis",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "docs:gen": "tsx src/docs/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack.ps1"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.1.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.16.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "swagger-ui-dist": "^5.32.15",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
